{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniVoice",
  "version": "1.0.0",
  "identifier": "com.aiden.omnivoice.win",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../web-dist-placeholder"
  },
  "app": {
    "windows": [
      {
        "title": "OmniVoice",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"]
  }
}
